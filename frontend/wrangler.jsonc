{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "distributed-search-engine",
  "main": "src/index.js",
  "compatibility_date": "2026-08-04",
  "routes": [
    {
      "pattern": "telemachus.relzarick.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": ".",
  },
  "observability": {
    "enabled": true,
  },
}
